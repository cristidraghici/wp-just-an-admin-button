#!/bin/bash

# Regex for semver format with v prefix (e.g., v1.2.3)
# You can adjust the regex if you want to allow pre-release tags like v1.2.3-beta.1
regex="^v[0-9]+\.[0-9]+\.[0-9]+$"

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
	# Only check tags
	if [[ "$remote_ref" == refs/tags/* ]]; then
		tag_name=${remote_ref#refs/tags/}
		
		# Allow deleting tags (local_sha will be all zeros)
		if [ "$local_sha" = "$z40" ]; then
			continue
		fi

		if ! [[ "$tag_name" =~ $regex ]]; then
			echo "Error: Tag '$tag_name' does not match the required semver format 'vX.Y.Z' (e.g., v1.2.3)"
			exit 1
		fi
	fi
done

exit 0
